# Copy to .env for local development. Never commit .env.
# All variables are optional — SafeGuard runs with zero external infrastructure
# using in-process defaults when these are unset.

# --- Service ---------------------------------------------------------------
SAFEGUARD_ENVIRONMENT=development       # development | staging | production
SAFEGUARD_LOG_LEVEL=INFO

# --- Decision policy -------------------------------------------------------
SAFEGUARD_POLICY_VERSION=2026.07.1
SAFEGUARD_BLOCK_THRESHOLD=0.90          # score at or above which we block
SAFEGUARD_REVIEW_THRESHOLD=0.60         # score at or above which we route to human review
SAFEGUARD_SHADOW_MODE=false             # evaluate and log, but always return ALLOW
SAFEGUARD_LATENCY_BUDGET_MS=150         # soft budget for the whole pipeline

# --- Feature store ---------------------------------------------------------
# Unset -> in-process store. Set -> Redis (requires safeguard[redis]).
# SAFEGUARD_REDIS_URL=redis://localhost:6379/0

# --- Decision event stream -------------------------------------------------
# Unset -> in-process buffer. Set -> Kafka (requires safeguard[kafka]).
# SAFEGUARD_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SAFEGUARD_KAFKA_DECISIONS_TOPIC=safeguard.decisions.v1

# --- Observability ---------------------------------------------------------
# SAFEGUARD_OTLP_ENDPOINT=http://localhost:4317
SAFEGUARD_SERVICE_NAME=safeguard
